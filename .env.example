# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:your-password@localhost:3306/wxgzh"

# Public base URL for generated links
APP_URL="http://localhost:3000"

# Secret used for sessions, captcha, and signed tokens. Replace with a long random value.
SESSION_SECRET="replace-with-a-long-random-session-secret"

# Initial super admin account for `npm run seed:super-admin`
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="admin123456"
SUPER_ADMIN_NAME="超级管理员"
